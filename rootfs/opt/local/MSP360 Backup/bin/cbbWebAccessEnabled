#!/bin/sh
#
# Determine if the native web interface can be enabled.
#

set -e # Exit immediately if a command exits with a non-zero status.
set -u # Treat unset variables as an error.

if [ -z "${CBB_WEB_INTERFACE_USER:-}" ]; then
    exit 1
elif [ ! -f /config/.cbb_web_interface_pass_hash ] && [ -z "${CBB_WEB_INTERFACE_PASSWORD:-}" ]; then
    exit 2
else
    exit 0
fi

# vim:ft=sh:ts=4:sw=4:et:sts=4
