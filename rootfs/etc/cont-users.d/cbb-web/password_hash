#!/bin/sh

set -e # Exit immediately if a command exits with a non-zero status.
set -u # Treat unset variables as an error.

if [ -f /config/.cbb_web_interface_clear_text_pass ]; then
    cat /config/.cbb_web_interface_clear_text_pass | /opt/base/bin/mkpasswd
elif [ -f /config/.cbb_web_interface_pass_hash ]; then
    cat /config/.cbb_web_interface_pass_hash
elif [ -n "${CBB_WEB_INTERFACE_PASSWORD:-}" ]; then
    echo "${CBB_WEB_INTERFACE_PASSWORD}" | /opt/base/bin/mkpasswd
fi

